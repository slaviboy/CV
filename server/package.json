{
  "name": "portfolio-contact-api",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless contact-form API for the portfolio: validates messages, stores them in MongoDB Atlas and sends an email notification.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env scripts/dev-server.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "mongodb": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x"
  }
}
